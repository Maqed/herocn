{
  "name": "herocn",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "check": "biome check --write .",
    "deps": "bunx taze@latest -rw",
    "deps:major": "bunx taze@latest major -rw",
    "prepare": "husky"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@herocn/config": "workspace:*",
    "@types/node": "^26.4.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "turbo": "^2.10.12",
    "typescript": "^7.0.2"
  },
  "lint-staged": {
    "*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc}": [
      "biome check --write ."
    ]
  },
  "packageManager": "bun@1.4.0"
}
